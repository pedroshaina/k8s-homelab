# CLI tools for the homelab. Install/update with: brew bundle
brew "opentofu"        # infrastructure as code (tofu)
brew "talosctl"        # Talos Linux API client
brew "kubernetes-cli"  # kubectl
brew "helm"            # Kubernetes package manager
brew "sops"            # encrypts secret values inside YAML files
brew "age"             # key pair used by sops
brew "pre-commit"      # runs checks before each commit
brew "gitleaks"        # detects committed credentials
brew "yamllint"        # YAML linter
brew "cilium-cli"      # Cilium status and troubleshooting
brew "k9s"             # terminal UI for Kubernetes
brew "jq"              # JSON processor
cask "1password-cli"   # op: 1Password CLI (service accounts, rate-limit checks)
# yq, kubeconform, argocd and promtool come from upstream release binaries instead
# (guide/01-workstation-and-repos.md: pinned versions and SHA-256), so every machine runs the
# exact versions the guide was written against.
